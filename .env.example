# Wayne Bot — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
# Async PostgreSQL connection URL for the main database
DATABASE_URL=postgresql+asyncpg://wayne:wayne@localhost:5432/wayne

# Test database URL (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://wayne:wayne@localhost:5432/wayne_test

# ─── LLM Provider API Keys ────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ─── Tool API Keys ────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── Model Configuration ──────────────────────────────────────────────────────
# Lightweight model used for auto-titling, summarization, and tool harness plumbing
LIGHTWEIGHT_MODEL=gpt-5-nano

# ─── Rolling Summary Thresholds ───────────────────────────────────────────────
# Fraction of context window at which rolling summary triggers (0.0–1.0)
SUMMARY_THRESHOLD=0.80

# Target fraction of context window for compressed context after summarization
SUMMARY_BUDGET=0.50

# ─── Web Search Configuration ─────────────────────────────────────────────────
# Minimum Tavily relevance score to keep a result (0.0–1.0)
TAVILY_SCORE_THRESHOLD=0.75

# Maximum age of search results in days
TAVILY_DATE_THRESHOLD_DAYS=365

# Comma-separated list of domains to exclude from search results (e.g. reddit.com,quora.com)
TAVILY_DOMAIN_BLACKLIST=

# Maximum number of Tavily retries per web search
SEARCH_MAX_RETRIES=2

# ─── Server Configuration ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
